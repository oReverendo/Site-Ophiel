{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/producto",
      "destination": "https://www.ophiel.eu",
      "permanent": true
    },
    {
      "source": "/empresa",
      "destination": "/agencia",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/all2/:usuario/contacto.vcf",
      "destination": "/api/vcard?u=:usuario"
    },
    {
      "source": "/all2/:usuario",
      "destination": "/api/pagina?u=:usuario"
    }
  ]
}
