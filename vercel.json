{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/producto",
      "destination": "https://www.ophiel.eu",
      "permanent": true
    },
    {
      "source": "/empresa",
      "destination": "/agencia",
      "permanent": true
    }
  ]
}